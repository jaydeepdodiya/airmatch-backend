PORT=3000
NODE_ENV=development

# Local dev shortcut — uses demo-user without Firebase token.
# Set to false to require real Bearer tokens (production / auth testing).
SKIP_AUTH=true

# MongoDB — local default; use Atlas URI in production.
MONGODB_URI=mongodb://127.0.0.1:27017/airmatch

# Required when SKIP_AUTH=false — path to Firebase service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Optional comma-separated CORS origins (web clients). Mobile apps ignore CORS.
# CORS_ORIGINS=http://localhost:5173

# Cloud deploy: paste service account JSON (Render/Railway env var)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Production template: see .env.production.example
