# Copy to Render/Railway env vars — never commit real secrets.
NODE_ENV=production
PORT=3000

# REQUIRED in production
SKIP_AUTH=false
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/airmatch

# Firebase Admin — use ONE of these:
# Option A (cloud): paste full JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B (local/VPS): path to file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Optional — comma-separated web origins if you add a web client
# CORS_ORIGINS=https://airmatch.app,https://admin.airmatch.app
